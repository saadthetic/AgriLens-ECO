# AgriLens Eco Environment Variables
# Server-side Gemini API key (for Express proxy)
GEMINI_API_KEY=your_gemini_api_key_here

# Client-side fallback Gemini API key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Weather API Key (e.g. WeatherAPI.com)
VITE_WEATHER_API_KEY=your_weather_api_key_here

# Cloud Firestore Configuration (Optional - falls back to localStorage if empty)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=agrilens-eco-punjab
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
